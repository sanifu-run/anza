{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanifu.run/anza/v1/plan.schema.json",
  "title": "Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "workspace_id",
    "catalog_digest",
    "facts_digest",
    "recommendation_digest",
    "created_at",
    "expires_at",
    "profile",
    "providers",
    "operations",
    "warnings",
    "manual_steps",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "facts_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recommendation_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "enum": [
        "beginner",
        "developer"
      ]
    },
    "providers": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "dependencies",
          "target_root",
          "relative_path",
          "expected_postimage_hash",
          "reversible",
          "privilege",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "recipe_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
          },
          "version": {
            "type": "string",
            "maxLength": 100
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
            },
            "maxItems": 500
          },
          "target_root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "preimage_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expected_postimage_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reversible": {
            "type": "boolean"
          },
          "privilege": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "maxItems": 500
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "maxItems": 200
    },
    "manual_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "maxItems": 200
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
